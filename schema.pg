// Omnigraph CRM Schema

node Account {
    name: String
    node_key: String @key
    risk_score: I32
}

node AccountEvent {
    event_id: String @key @index
    source: String
    timestamp: Date @index
    risk_signals: [String]?
    raw_text: String?
}

edge HAS_EVENT: Account -> AccountEvent {
    @unique(src, dst)
}
