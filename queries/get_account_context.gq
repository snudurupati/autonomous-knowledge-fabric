query get_account_context($node_key: String) {
    match {
        $a: Account { node_key: $node_key }
        $a has_event $e
        $e: AccountEvent
    }
    return {
        $a.name,
        $a.node_key,
        $a.risk_score,
        $e.event_id,
        $e.source,
        $e.timestamp,
        $e.risk_signals,
        $e.raw_text
    }
}
