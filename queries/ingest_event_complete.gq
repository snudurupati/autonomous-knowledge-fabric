query ingest_event_complete($name: String, $node_key: String, $risk_score: I32,
                            $event_id: String, $source: String, $timestamp: Date,
                            $risk_signals: [String], $raw_text: String) {
    insert Account {
        name: $name,
        node_key: $node_key,
        risk_score: $risk_score
    }
    insert AccountEvent {
        event_id: $event_id,
        source: $source,
        timestamp: $timestamp,
        risk_signals: $risk_signals,
        raw_text: $raw_text
    }
    insert HAS_EVENT { from: $node_key, to: $event_id }
}
